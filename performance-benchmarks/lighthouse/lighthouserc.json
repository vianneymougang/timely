{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Application bundle generation complete",
      "url": [
        "http://localhost:4200/",
        "http://localhost:4200/login",
        "http://localhost:4200/dashboard",
        "http://localhost:4200/schedules",
        "http://localhost:4200/reports",
        "http://localhost:4200/users"
      ],
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        },
        "screenEmulation": {
          "mobile": false,
          "width": 1920,
          "height": 1080,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "formFactor": "desktop",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.9}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.9}],
        "categories:seo": ["error", {"minScore": 0.9}],

        "first-contentful-paint": ["warn", {"maxNumericValue": 2000}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 2500}],
        "speed-index": ["warn", {"maxNumericValue": 3000}],
        "total-blocking-time": ["warn", {"maxNumericValue": 300}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
        "interactive": ["warn", {"maxNumericValue": 3500}],

        "uses-responsive-images": "warn",
        "uses-optimized-images": "warn",
        "offscreen-images": "warn",
        "uses-webp-images": "warn",
        "modern-image-formats": "warn",
        "efficient-animated-content": "warn",

        "uses-text-compression": "warn",
        "unused-css-rules": "warn",
        "unused-javascript": "warn",
        "render-blocking-resources": "warn",
        "unminified-css": "error",
        "unminified-javascript": "error",

        "dom-size": ["warn", {"maxNumericValue": 1500}],
        "mainthread-work-breakdown": ["warn", {"maxNumericValue": 4000}],
        "bootup-time": ["warn", {"maxNumericValue": 3500}]
      }
    },
    "upload": {
      "target": "temporary-public-storage",
      "reportFilenamePattern": "lighthouse-%%PATHNAME%%-%%DATETIME%%.report.%%EXTENSION%%"
    },
    "server": {
      "port": 9001,
      "storage": {
        "storageMethod": "sql",
        "sqlDatabasePath": "./.lighthouseci/db.sql"
      }
    }
  }
}
