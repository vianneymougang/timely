{
  "name": "timely-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "e2e:smoke": "playwright test e2e/tests/smoke.spec.ts",
    "e2e:auth": "playwright test e2e/tests/auth.spec.ts",
    "e2e:users": "playwright test e2e/tests/users.spec.ts",
    "e2e:planning": "playwright test e2e/tests/planning.spec.ts",
    "e2e:reports": "playwright test e2e/tests/reports.spec.ts",
    "lighthouse": "bash ../performance-benchmarks/lighthouse/scripts/run-lighthouse.sh",
    "perf:lighthouse": "npm run lighthouse",
    "perf:all": "bash ../performance-benchmarks/scripts/run-all-benchmarks.sh --frontend-only"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/material": "^20.2.13",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@ng-icons/core": "^33.2.2",
    "@ng-icons/phosphor-icons": "^33.2.2",
    "@primeng/themes": "^21.0.4",
    "@primeuix/themes": "^2.0.3",
    "@scripttype/ng-motion": "^0.5.0",
    "@types/node": "^25.2.3",
    "lucide-angular": "^0.554.0",
    "primeng": "^21.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.0",
    "@playwright/test": "^1.58.2",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.9.2"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
