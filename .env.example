# ====================================
# Timely Project - Environment Variables
# ====================================
# Copy this file to .env and update with your actual values
# NEVER commit the .env file to version control

# Database Configuration
# -----------------------
# PostgreSQL password for all microservices databases
# Used by: auth-service, user-service, planning-service, booking-service, report-service, agora-service
DB_PASSWORD=changeme

# MongoDB password for notification service
# Used by: notification-service
MONGODB_PASSWORD=changeme

# JWT Secret Key
# -----------------------
# Secret key for JWT token generation and validation
# REQUIRED: Must be at least 256 bits (32 characters) for HS256 algorithm
# Used by: auth-service, agora-service
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-minimum-256-bits

# RabbitMQ Configuration
# -----------------------
# RabbitMQ credentials for message queue communication
# Used by: all services
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=changeme

# Agora API Configuration
# -----------------------
# External Agora API credentials
# Used by: agora-service
AGORA_API_URL=https://api.agora.example.com
AGORA_USERNAME=admin
AGORA_PASSWORD=changeme

# Twilio Configuration
# -----------------------
# Twilio SMS service credentials (optional)
# Used by: notification-service
TWILIO_ACCOUNT_SID=changeme
TWILIO_AUTH_TOKEN=changeme
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_ENABLED=false

# Firebase Configuration
# -----------------------
# Firebase push notification service (optional)
# Used by: notification-service
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_ENABLED=false

# CORS Configuration
# -----------------------
# Allowed origins for Cross-Origin Resource Sharing
# Multiple origins separated by commas
# Used by: api-gateway, auth-service
# Example: CORS_ORIGINS=http://localhost:4200,https://app.example.com
CORS_ORIGINS=http://localhost:4200
